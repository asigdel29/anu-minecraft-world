# PostHog product analytics (optional).
# Set these in Vercel Project Settings -> Environment Variables and in a local
# .env for development. When VITE_PUBLIC_POSTHOG_KEY is unset, analytics is a
# no-op. Vercel Web Analytics and Speed Insights need no keys — enable them in
# the Vercel dashboard.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Multiplayer relay (optional).
# Host of the deployed Cloudflare Worker relay (see worker.js / wrangler.toml).
# When unset, the world runs solo (no socket is opened). For local development
# run `npm run relay:dev` and set this to localhost:8787 (the wrangler dev port).
VITE_MULTIPLAYER_HOST=anu-minecraft-world.anubhavsigdel.workers.dev

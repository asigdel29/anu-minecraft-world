# PostHog product analytics (optional).
# Set these in Vercel Project Settings -> Environment Variables and in a local
# .env for development. When VITE_PUBLIC_POSTHOG_KEY is unset, analytics is a
# no-op. Vercel Web Analytics and Speed Insights need no keys — enable them in
# the Vercel dashboard.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PartyKit multiplayer (optional).
# Host of the deployed PartyKit relay. When unset, the world runs solo (no
# socket is opened). For local development run `npm run party` and set this to
# localhost:1999 (the default PartyKit dev port).
VITE_PARTYKIT_HOST=anu-minecraft-world.partykit.dev
